DATABASE_URL=postgresql://sidegig:sidegig_pw@db:5432/sidegig
# docker-compose.yml의 db 서비스 비밀번호도 이 값을 씁니다(기본값 sidegig_pw와 동일).
# 바꾸고 싶다면 아래 POSTGRES_PASSWORD와 위 DATABASE_URL의 비밀번호를 반드시 같이 바꾸세요.
POSTGRES_PASSWORD=sidegig_pw

# 9/2 세 번째 업데이트(보안 강화): Redis는 기본적으로 인증이 전혀 없어서, docker
# 내부망이라도 컨테이너 하나가 뚫리면 Redis 데이터에 누구나 접근할 수 있었습니다.
# --requirepass로 비밀번호를 강제합니다. REDIS_PASSWORD를 바꾸면 아래 REDIS_URL의
# 비밀번호(redis://:<비밀번호>@redis:6379/0 형식)도 반드시 같이 바꾸세요.
REDIS_PASSWORD=sidegig_redis_pw
REDIS_URL=redis://:sidegig_redis_pw@redis:6379/0

# 없으면 data_pipeline/expense_classifier.py가 자동으로 Mock 모드로 동작합니다.
# 실제 키를 여기 넣더라도 이 파일(.env.example)이 아니라 .env(gitignore 대상)에 넣으세요.
GEMINI_API_KEY=

# 8/30 추가: 이 값을 채우면 모든 /api/v1/* 요청에 X-API-Key 헤더가 필수가 됩니다.
# 로컬 개발 중에는 비워둬도 됩니다(Swagger UI로 바로 테스트 가능). 깃허브 배포용
# 서버에서는 반드시 채워서 배포하세요 — app/security.py 참고.
API_ACCESS_KEY=

# 8/30 추가: 프론트를 API와 다른 origin(포트)에서 띄울 때 허용할 주소.
# 콤마로 여러 개 나열 가능. 기본값은 흔한 로컬 개발 주소들입니다.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
